# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.html
coverage.txt
coverage.xml
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Planejamento interno (acompanhamento local, fora do versionamento)
docs/PLANEJAMENTO.md

# Node / frontend
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/
playwright-report/
test-results/

# Ambiente local
.env.*
!.env.example
.DS_Store

# Artefatos do projeto legado
legacy/uploads/
legacy/outputs/
legacy/temp/
