# Copie para .env para rodar fora do Docker (npm run start:dev), com a infra do compose no ar
PORT=3003
RABBITMQ_URL=amqp://fiapx:fiapx@localhost:5672
REDIS_URL=redis://localhost:6379/1

# SMTP: Mailpit no ambiente local (caixa de entrada em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="FIAP X <nao-responda@fiapx.local>"

# Link "Ver meus vídeos" do e-mail
APP_URL=http://localhost:8080
IDEMPOTENCY_TTL_DAYS=7
LOG_LEVEL=info
