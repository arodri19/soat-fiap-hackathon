# Copie para .env para rodar fora do Docker (npm run start:dev)
PORT=3001
DATABASE_URL=postgresql://auth_user:auth_pass@localhost:5432/auth_db?schema=public
REDIS_URL=redis://localhost:6379/0
# Aplica migrations/*.sql no boot (ou rode `npm run migrate`)
MIGRATE_ON_START=true

# JWT RS256. Sem chave em desenvolvimento, uma chave temporária é gerada no boot
# (tokens deixam de valer ao reiniciar). Em produção é obrigatória.
# JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-private.pem
JWT_ISSUER=fiapx-auth
JWT_AUDIENCE=fiapx
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Cookie do refresh token (Secure exige HTTPS; desligado no ambiente local)
COOKIE_SECURE=false
COOKIE_PATH=/api/auth

# Rate limit de login: falhas por e-mail + IP dentro da janela
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

BCRYPT_COST=12
LOG_LEVEL=info
