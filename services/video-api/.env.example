# Copie para .env para rodar fora do Docker (npm run start:dev), com a infra do compose no ar
PORT=3002
DATABASE_URL=postgresql://video_user:video_pass@localhost:5432/video_db
MIGRATE_ON_START=true
RABBITMQ_URL=amqp://fiapx:fiapx@localhost:5672

# MinIO/S3. S3_PUBLIC_ENDPOINT entra nas URLs de download: precisa abrir no navegador.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RAW=raw-videos
S3_BUCKET_ZIP=frame-zips

# Validação do JWT emitido pelo auth-service (chave pública via JWKS)
JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=fiapx-auth
JWT_AUDIENCE=fiapx

MAX_UPLOAD_MB=500
DOWNLOAD_URL_TTL_SECONDS=300
OUTBOX_POLL_INTERVAL_MS=500
LOG_LEVEL=info
