# Copie para .env e ajuste se necessário: cp .env.example .env
# Valores apenas para desenvolvimento local.

# PostgreSQL (superusuário da instância)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Um database e um usuário por serviço (banco por serviço)
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass
VIDEO_DB_NAME=video_db
VIDEO_DB_USER=video_user
VIDEO_DB_PASSWORD=video_pass

# RabbitMQ (usuário definido em infra/rabbitmq/definitions.json: fiapx / fiapx)

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_RAW=raw-videos
MINIO_BUCKET_ZIP=frame-zips

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Porta pública do gateway
GATEWAY_PORT=8080
